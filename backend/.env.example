# Copy to .env and fill in. Every setting is optional except the API key for the AI assistant.
# Blank values mean "use the default".

# --- AI assistant (https://openrouter.ai/keys) ---------------------------------
OPENROUTER_API_KEY=
# Must accept a whole transcript: pick a long-context model. Gemma 4 26B: 262K context, cheap.
LLM_MODEL=google/gemma-4-26b-a4b-it
# Optional: describe keyframes (charts, diagrams) with a vision model. Empty = off (OCR still runs).
VISION_MODEL=
VISION_MAX_FRAMES=12
# true = nothing is ever sent to an external service (assistant and captions are disabled).
LOCAL_ONLY=false
# How requests reach OpenRouter. auto = Windows' built-in curl (survived networks that corrupt
# large uploads), elsewhere httpx. Failed requests are retried 3 times either way.
LLM_TRANSPORT=auto             # auto | curl | httpx
LLM_TIMEOUT=180                # seconds per assistant request

# --- Speech recognition --------------------------------------------------------
WHISPER_ENGINE=auto            # auto | faster | openai
# auto = large-v3-turbo on a GPU with >= 5 GB, small on smaller GPUs, base on CPU.
# Or name one: tiny | base | small | medium | large-v3 | large-v3-turbo | distil-large-v3
WHISPER_MODEL=auto
# The running preview during live meetings (every meeting is redone with WHISPER_MODEL afterwards).
LIVE_WHISPER_MODEL=auto
WHISPER_DEVICE=auto            # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto      # auto = float16 on GPU, int8 on CPU
WHISPER_BEAM_SIZE=5
# e.g. en or tl; empty = auto-detect by voting over 8 speech windows spread across the recording
# (can also be set per upload). Mixed English/Filipino classes are usually best as tl.
TRANSCRIBE_LANGUAGE=
WORD_TIMESTAMPS=true           # sentence-level segments, word highlighting and confidence
WHISPER_BATCH_SIZE=            # 30-s windows decoded at once on a GPU; empty = 16 with >= 8 GB VRAM, else 8

# --- Speaker identification (who spoke when) -----------------------------------
DIARIZATION=true               # the voice-print model (~27 MB) downloads on first use
# fast = one voice print per sentence (about 1 minute per hour of audio on a laptop);
# precise = full diarization that also splits overlapping speech (about 8x slower).
DIARIZATION_MODE=fast          # fast | precise
DIARIZATION_THRESHOLD=         # empty = 0.5; lower = more speakers
MODELS_DIR=                    # default: backend/models

# --- Video processing ----------------------------------------------------------
VIDEO_PROCESSING=true
OCR_ENABLED=true
OCR_THREADS=4                  # per OCR engine; more was slower on a 16-thread laptop
OCR_WORKERS=2                  # OCR engines running in parallel
VIDEO_SAMPLE_FPS=1.0           # frames per second examined for scene changes
SCENE_THRESHOLD=0.02           # fraction of pixels that must change to count as a new scene
SCENE_MIN_GAP=2.0              # seconds
SCENE_MAX_GAP=60.0             # force a keyframe at least this often
MAX_KEYFRAMES=150
VOCABULARY_SIZE=60             # on-screen terms given to the speech model as spelling hints

# --- Library & server ----------------------------------------------------------
KEEP_MEDIA=true                # keep recordings so the library can play them back and reprocess
JOB_TTL_HOURS=0                # delete finished recordings after this many hours; 0 = keep
MAX_UPLOAD_MB=4096
MAX_MEDIA_MINUTES=600
DATA_DIR=                      # default: backend/data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # any localhost port is allowed anyway
